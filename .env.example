# Cyphor configuration. Every value is optional. With nothing set, Cyphor runs on a local SQLite file
# and answers with the built-in demo model.
#
# Two files hold settings, and a real environment variable always wins over both:
#   LLM.env     your provider keys, one NAME=value per line. Create it next to package.json.
#   .env.local  everything else (database, limits).
# Both are ignored by git. This file lists names only: never put a real key in a file you commit.
# After editing LLM.env, restart the server or press Refresh in Settings > Router.

# ---------------------------------------------------------------------------------------------
# LLM.env: one line for each provider you use. Leave out the ones you do not have.
# ---------------------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=
META_API_KEY=
MISTRAL_API_KEY=
AIONLABS_API_KEY=
CLOUDFLARE_API_KEY=
# Cloudflare Workers AI also needs your account id (or a token that may read your account).
CLOUDFLARE_ACCOUNT_ID=
# Web search and page reading for grounded answers. It is a tool, not a chat model.
TINYFISH_API_KEY=

# A server of your own that speaks the OpenAI chat API (Ollama, LM Studio, vLLM...).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODELS=llama3.1:8b,qwen2.5-coder:7b

# Providers whose address could not be checked against their live documentation can be pointed
# somewhere else, and any provider's model list can be pinned (comma separated):
# ZAI_BASE_URL=
# NVIDIA_BASE_URL=
# META_BASE_URL=
# MISTRAL_BASE_URL=
# AIONLABS_BASE_URL=
# GROQ_MODELS=
# OPENROUTER_MODELS=

# ---------------------------------------------------------------------------------------------
# .env.local: the rest. All of these have defaults.
# ---------------------------------------------------------------------------------------------

# Database (libsql / SQLite). A local file by default; use a Turso URL in production.
# DATABASE_URL=file:./.data/cyphor.db
# DATABASE_AUTH_TOKEN=

# Router and God Mode.
# ROUTER_FIRST_BYTE_MS=25000     wait this long for a first word before trying another model
# CATALOG_TTL_SEC=600            how long the list of models is remembered
# GODMODE_MAX_PANEL=6            most providers asked at once (the Settings slider goes up to this)
# GODMODE_DRAFT_MS=45000         stop waiting for drafts after this long
# GODMODE_GRACE_MS=8000          extra wait for slow providers once enough drafts are in

# Requests per minute, per visitor.
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_API_PER_MIN=120
# RATE_LIMIT_GOD_PER_MIN=6

# A shared password for the whole app. Set it before Cyphor is served where other people can reach it:
# without it, anyone who can open the address can spend your provider keys. Write it as name:password
# and serve the app over https, because the browser sends it with every request. A value that is not
# name:password locks the app instead of opening it.
# CYPHOR_BASIC_AUTH=name:password
# RATE_LIMIT_AUTH_PER_MIN=10     wrong passwords allowed per address per minute

# The public address of the app, when it is served somewhere other than localhost.
# APP_URL=https://chat.example.com

# Automated tests only: ignore LLM.env, so they never pick up your real keys.
# LLM_ENV_DISABLE=1
