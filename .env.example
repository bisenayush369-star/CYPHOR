# Cyphor configuration. This file lists names only: never put a real key or password in a file you commit.
#
# Two files hold settings, and a real environment variable always wins over both:
#   LLM.env     your provider keys, one NAME=value per line. Create it next to package.json.
#   .env.local  everything else (database, sign-in, limits). Create it next to package.json too.
# Both are ignored by git. After editing LLM.env, restart the server or press Refresh in Settings > Router.
#
# The two things you need before you can sign in: DATABASE_URL (a Neon database) and, once the app
# is served on the internet, BETTER_AUTH_SECRET. Everything else is optional.

# ---------------------------------------------------------------------------------------------
# .env.local: the database and sign-in
# ---------------------------------------------------------------------------------------------

# Your Neon database. In the Neon console open the project, press Connect, and copy the connection
# string (keep the Connection pooling switch on: the host then has "-pooler" in it). Paste the string
# exactly as Neon shows it. Neon needs an encrypted connection, and Cyphor always checks the server's
# certificate on a Neon address (sslmode=verify-full), whichever sslmode the string says. The app
# creates its own tables the first time it connects. There is nothing to migrate.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# To try the app with no database account at all, point it at a Postgres that runs inside the app:
#   DATABASE_URL=pglite://./.data/pg       saved in a folder
#   DATABASE_URL=pglite://memory           gone when the server stops
# That is for trying and testing, not for a server other people use.

# DATABASE_POOL_MAX=5       connections held per server process (Neon limits them)
# DB_AUTO_MIGRATE=1         set to 0 if you manage the tables yourself with `npm run db:push`

# The key that signs sign-in sessions. At least 32 characters: `openssl rand -base64 32`.
# While developing you can leave it out (a random one is kept in .data/auth-secret). On a live server
# nobody can sign in until it is set, and the screen says so, because a guessable key lets anyone forge a session.
# BETTER_AUTH_SECRET=

# The public address of the app. Set it wherever the app is served from something other than
# http://localhost:3000. Sign-in only accepts requests from this address, and Google sends people back to it.
# BETTER_AUTH_URL=https://chat.example.com
# TRUSTED_ORIGINS=https://www.example.com,https://other.example.com    extra addresses allowed to sign in

# "Continue with Google". Without both values the button is switched off while you develop (with a
# hint saying why) and hidden on a live server.
#   1. Google Cloud console > APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
#   2. Authorized redirect URI: <your address>/api/auth/callback/google
#        local:       http://localhost:3000/api/auth/callback/google
#        production:  https://chat.example.com/api/auth/callback/google
#   3. Copy the client ID and secret here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# LLM.env: one line for each provider you use. Leave out the ones you do not have.
# ---------------------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=
META_API_KEY=
MISTRAL_API_KEY=
AIONLABS_API_KEY=
CLOUDFLARE_API_KEY=
# Cloudflare Workers AI also needs your account id (or a token that may read your account).
CLOUDFLARE_ACCOUNT_ID=
# Web search and page reading for grounded answers. It is a tool, not a chat model.
TINYFISH_API_KEY=

# A server of your own that speaks the OpenAI chat API (Ollama, LM Studio, vLLM...).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODELS=llama3.1:8b,qwen2.5-coder:7b

# Providers whose address could not be checked against their live documentation can be pointed
# somewhere else, and any provider's model list can be pinned (comma separated):
# ZAI_BASE_URL=
# NVIDIA_BASE_URL=
# META_BASE_URL=
# MISTRAL_BASE_URL=
# AIONLABS_BASE_URL=
# GROQ_MODELS=
# OPENROUTER_MODELS=

# ---------------------------------------------------------------------------------------------
# .env.local: the rest. All of these have defaults.
# ---------------------------------------------------------------------------------------------

# Router and God Mode.
# ROUTER_FIRST_BYTE_MS=25000     wait this long for a first word before trying another model
# CATALOG_TTL_SEC=600            how long the list of models is remembered
# GODMODE_MAX_PANEL=6            most providers asked at once (the Settings slider goes up to this)
# GODMODE_DRAFT_MS=45000         stop waiting for drafts after this long
# GODMODE_GRACE_MS=8000          extra wait for slow providers once enough drafts are in

# Requests per minute, per signed-in person.
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_API_PER_MIN=120
# RATE_LIMIT_GOD_PER_MIN=6

# An extra shared password in front of the whole app, on top of signing in (optional). Write it as
# name:password and serve the app over https, because the browser sends it with every request. A value
# that is not name:password locks the app instead of opening it.
# CYPHOR_BASIC_AUTH=name:password
# RATE_LIMIT_AUTH_PER_MIN=10     wrong passwords allowed per address per minute

# Used by tests only. Do not set these on a server people use.
# LLM_ENV_DISABLE=1              ignore LLM.env, so tests never pick up your real keys
# AUTH_RATE_LIMIT=off            turn off the sign-in rate limit (tests create many accounts from one address)
